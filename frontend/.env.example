# Base URL of the Cube backend (cube.war).
# Default "/cube" = same WebLogic origin as the frontend, so no CORS is needed.
# Only set a full URL if the backend lives on another host (then also set
# CUBE_CORS_ALLOWED_ORIGINS on the backend).
VITE_API_BASE_URL=/cube

# Development only: where `npm run dev` proxies /cube requests.
CUBE_BACKEND_URL=http://127.0.0.1:8080
